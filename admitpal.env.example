# Admit Pal Essay Coach settings. Paste a key after the = for each provider you use; leave the others blank.
# Save this file as admitpal.env (it is git-ignored) and restart essay_server.py after editing it. Never commit real keys.
# Format: NAME=value, no spaces or quotes. Lines starting with # are ignored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional: change a model (any LiteLLM model string), e.g.
# ADMITPAL_OPENAI_MODEL=openai/gpt-6-astra
# Gemini defaults to gemini/gemini-flash-latest, which works on Google's free tier (Pro models have no free quota).
# ADMITPAL_GEMINI_MODEL=gemini/gemini-flash-latest

# Optional: which provider the picker starts on, reply temperature, and test mode (canned replies, no keys or cost).
# ADMITPAL_DEFAULT=gemini
# ADMITPAL_TEMPERATURE=0.4
# ADMITPAL_MOCK=1
